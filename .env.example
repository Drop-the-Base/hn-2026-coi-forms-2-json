# Konfiguracja runtime (NFR-08). Skopiuj do .env i uzupełnij. .env nie trafia do gita.
# Zmienne bez wartości domyślnej w kodzie są wymagane; reszta ma tu wartość domyślną z config.py.

# --- JWT (FR-10) ---
# Wymagany, min. 32 znaki. Wygeneruj: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=forms2json
JWT_AUDIENCE=forms2json-api
JWT_TTL_SECONDS=3600

# --- RabbitMQ (ADR-0004) ---
# compose składa z nich RABBITMQ_URL dla api i workera. Hasło wygeneruj: openssl rand -hex 16
RABBITMQ_USER=forms2json
RABBITMQ_PASSWORD=

# --- Pliki i wyniki (NFR-06, FR-05) ---
# Maks. rozmiar pliku w bajtach (20 MB). Wolumen tmpfs w compose.yaml ma 256 MB, /tmp api 64 MB.
MAX_UPLOAD_BYTES=20971520
# Po tylu sekundach sprzątacz usuwa plik zadania, którego worker nie usunął.
FILE_TTL_SECONDS=900
# Tyle sekund API trzyma wynik w pamięci.
RESULT_TTL_SECONDS=1800
# Tyle czeka POST /api/v1/forms:convert, zanim odda 202 z job_id (FR-06).
SYNC_TIMEOUT_SECONDS=120

# --- LLM (ADR-0007) ---
# Ollama na hoście. Z profilem `llm` (Ollama w kontenerze): http://llm-runtime:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Model musi być pobrany wcześniej: ollama pull qwen2.5:7b-instruct
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=120
# Klucz dostawcy w chmurze (ADR-0028). Ollama go ignoruje. Prawdziwy klucz tylko w .env, nie w repo.
LLM_API_KEY=local
# json_schema (strict) albo json_object (schemat w prompcie), gdy dostawca nie wspiera strict.
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_INPUT_CHARS=30000
# Limit tokenów odpowiedzi. Ucięta odpowiedź kończy się od razu błędem, bez ponawiania.
# Ollama musi mieć okno kontekstu >= prompt + ten limit: OLLAMA_CONTEXT_LENGTH=16384 (README).
LLM_MAX_OUTPUT_TOKENS=4096

# --- Wynik (FR-T1) ---
# Element z confidence poniżej progu wymaga przeglądu człowieka.
CONFIDENCE_REVIEW_THRESHOLD=0.85

# --- OCR (FR-02, ADR-0029) ---
# Język Tesseracta; obraz workera ma tylko pakiet pol (i eng).
OCR_LANG=pol

# --- Koszt (NFR-13) ---
# Umowne stawki do porównywania modeli; metryka forms2json_job_cost. 0 = koszt nieliczony.
COST_PER_1K_TOKENS=0
COST_PER_GPU_SECOND=0
